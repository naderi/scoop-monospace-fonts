{
    "version": "2.5.0",
    "description": "IBM's new corporate typeface family. It’s global, it’s versatile and it’s distinctly IBM.",
    "homepage": "https://github.com/IBM/plex",
    "license": "SIL OFL 1.1",
    "url": "https://github.com/IBM/plex/releases/download/%40ibm%2Fplex-mono%402.5.0/ibm-plex-mono.zip",
    "hash": "6d23f01257663d8cc49a0d64c22ced630b79e0e2a0ac08a0da86e9a38bbc481c",
    "pre_install": [
        "Move-Item $dir\\ibm-plex-mono\\fonts\\complete\\ttf\\*.ttf $dir",
        "Remove-Item $dir\\* -exclude *.ttf -Force -Recurse",
        "Get-ChildItem \"$dir\" -Recurse -Directory | Remove-Item -Recurse"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": {
        "url": "https://github.com/IBM/plex/tags",
        "regex": "@ibm/plex-mono@([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/IBM/plex/releases/download/%40ibm%2Fplex-mono%40$version/ibm-plex-mono.zip"
    }
}
