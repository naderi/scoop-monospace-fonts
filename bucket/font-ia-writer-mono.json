{
    "version": "2.000",
    "description": "The iA Writer fonts comes bundled with iA Writer for for Android, Windows, Mac, iPadOS and iOS",
    "homepage": "https://github.com/iaolo/iA-Fonts",
    "license": "SIL OFL 1.1",
    "url": [
        "https://github.com/iaolo/iA-Fonts/raw/refs/heads/master/iA%20Writer%20Mono/Static/iAWriterMonoS-Bold.ttf",
        "https://github.com/iaolo/iA-Fonts/raw/refs/heads/master/iA%20Writer%20Mono/Static/iAWriterMonoS-BoldItalic.ttf",
        "https://github.com/iaolo/iA-Fonts/raw/refs/heads/master/iA%20Writer%20Mono/Static/iAWriterMonoS-Italic.ttf",
        "https://github.com/iaolo/iA-Fonts/raw/refs/heads/master/iA%20Writer%20Mono/Static/iAWriterMonoS-Regular.ttf"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    }
}
