{
    "version": "7.9",
    "description": "An open source monospace font with round corner and ligatures for IDE and command line. (Minimal version, ttf format, unhinted version)",
    "homepage": "https://github.com/subframe7536/Maple-font",
    "license": "OFL-1.1",
    "url": "https://github.com/subframe7536/Maple-font/releases/download/v7.9/MapleMono-TTF.zip",
    "hash": "3a35f8f0669bef3dded9df208cc4526a6f7573210e134816e9084a8981271d75",
    "pre_install": "Get-ChildItem \"$dir\" | Where-Object { $_.Extension -notin '.ttf', '.otf' } | Remove-Item -Recurse -Force",
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/subframe7536/Maple-font/releases/download/v$version/MapleMono-TTF.zip",
        "hash": {
            "url": "$baseurl/MapleMono-TTF.sha256"
        }
    }
}
