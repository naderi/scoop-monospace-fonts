{
    "version": "1.000",
    "description": "Sometype Mono is a monospaced font family for coding and tabular layout.",
    "homepage": "https://github.com/dharmatype/Sometype-Mono",
    "license": "SIL OFL 1.1",
    "url": [
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-Bold.ttf",
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-BoldItalic.ttf",
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-Italic.ttf",
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-Medium.ttf",
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-MediumItalic.ttf",
        "https://github.com/dharmatype/Sometype-Mono/raw/refs/heads/master/fonts/ttf/SometypeMono-Regular.ttf"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    }
}
