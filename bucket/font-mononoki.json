{
    "version": "1.6",
    "description": "The Ubuntu typeface has been specially created to complement the Ubuntu tone of voice.",
    "homepage": "https://github.com/madmalik/mononoki",
    "license": "SIL OFL 1.1",
    "url": "https://github.com/madmalik/mononoki/releases/download/1.6/mononoki.zip",
    "hash": "86549faebfd9231c3bd0942038cb1f717f5186729c9a54d0045e36b996c1a355",
    "extract_dir": "Ubuntu-Sans-Mono-fonts-v1.100",
    "pre_install": "Get-ChildItem \"$dir\" | Where-Object { $_.Extension -notin '.ttf' } | Remove-Item -Recurse -Force",
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/madmalik/mononoki/releases/download/$version/mononoki.zip"
    }
}
