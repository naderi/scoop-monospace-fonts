{
    "version": "34.9.0",
    "description": "Iosevka is an open-source, sans-serif + monospace typeface family, designed for writing code, using in terminals, and preparing technical documents.",
    "homepage": "https://github.com/be5invis/iosevka",
    "license": "SIL OFL 1.1",
    "url": "https://github.com/be5invis/Iosevka/releases/download/v34.9.0/PkgTTC-SGr-Iosevka-34.9.0.zip",
    "hash": "f179bf93214f81120d4d148227cdc05656280efc76f653a66ba65faf0435a123",
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/be5invis/Iosevka/releases/download/v$version/PkgTTC-SGr-Iosevka-$version.zip"
    }
}
