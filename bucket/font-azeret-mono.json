{
    "version": "1.002",
    "description": "Azeret is a sans-serif typeface with a mono-linear character. ",
    "homepage": "https://github.com/displaay/Azeret",
    "license": "SIL OFL 1.1",
    "url": [
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Black.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-BlackItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Bold.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-BoldItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-ExtraBold.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-ExtraBoldItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-ExtraLight.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-ExtraLightItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Italic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Light.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-LightItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Medium.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-MediumItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Regular.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-SemiBold.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-SemiBoldItalic.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-Thin.ttf",
        "https://github.com/displaay/Azeret/raw/refs/heads/main/fonts/ttf/AzeretMono-ThinItalic.ttf"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\monospace-fonts\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    }
}
